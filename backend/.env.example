# 应用配置
APP_ENV=local
APP_NAME=qa-platform
APP_VERSION=0.1.0
API_PREFIX=/api/v1
DEBUG=true

# 数据库配置
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qa_platform
# 数据库 SSL（本地留空即可；生产库强制 SSL 时由 Apollo 下发）
# 取值: 空=默认 prefer / disable / prefer / require / verify-ca / verify-full
DB_SSL_MODE=
# CA 根证书路径（仅 verify-ca / verify-full 校验服务端证书时需要）
DB_SSL_ROOT_CERT=

# Redis配置
REDIS_URL=redis://localhost:6379/0
# arq 任务队列（异步执行引擎，独立 DB 与缓存隔离）
ARQ_REDIS_URL=redis://localhost:6379/1

# MinIO配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=qa-platform
MINIO_SECURE=false

# JWT配置
JWT_SECRET_KEY=dev-secret-key-change-in-production-9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# 加密配置
ENCRYPTION_KEY=dev-encryption-key-32-bytes-minimum-length-required

# 飞书配置（可选，暂不启用）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:8000/api/v1/auth/feishu/callback
# 飞书群机器人 Webhook（SLA/计划告警默认推送地址，告警渠道未单独配置 webhook 时使用）
FEISHU_WEBHOOK_URL=

# CORS配置
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# 执行引擎配置
EXECUTION_MAX_STEP_SECONDS=120
EXECUTION_MAX_RESPONSE_BYTES=10485760
EXECUTION_DEFAULT_TIMEOUT_MS=30000

# 调度器配置
SCHEDULER_SCAN_INTERVAL_SECONDS=10
SCHEDULER_LOCK_EXPIRE_SECONDS=30

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json

# Prometheus配置
METRICS_ENABLED=true
METRICS_PORT=9090
